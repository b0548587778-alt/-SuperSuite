{
  "name": "super-suite",
  "version": "3.10.0",
  "description": "חבילת העבודה המאוחדת — כלכלה, שמאות, כושר וכלים",
  "main": "main.js",
  "author": "Bunim Seller",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node run-electron.js",
    "dist": "electron-builder --win nsis portable",
    "dist:local": "node build-local.js",
    "dist:check": "node build-local.js --check",
    "test": "node --test --test-concurrency=6 \"tests/*.test.js\"",
    "test:serial": "node --test --test-concurrency=1 \"tests/*.test.js\"",
    "dist:android": "node android/build-apk.js",
    "dist:android:check": "node android/build-apk.js --check",
    "build:trainer": "node tools/build-trainer.js",
    "build:trainer:check": "node tools/build-trainer.js --check"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bunimseller.supersuite",
    "productName": "SuperSuite",
    "copyright": "© Bunim Seller",
    "files": [
      "main.js",
      "shell/**/*",
      "modules/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt",
      "build/eula.txt"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SuperSuite-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "license": "build/eula.txt",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "he_IL"
      ],
      "language": "1037",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SuperSuite-Setup.${ext}"
    },
    "icon": "build/icon.ico",
    "extraFiles": [
      {
        "from": "LICENSE.txt",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "build/eula.txt",
        "to": "EULA.txt"
      }
    ]
  }
}
