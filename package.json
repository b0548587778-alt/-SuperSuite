{
  "name": "super-suite",
  "version": "3.1.0",
  "description": "חבילת העבודה המאוחדת — כלכלה, שמאות, כושר וכלים",
  "main": "main.js",
  "author": "Bunim Seller",
  "license": "MIT",
  "scripts": {
    "start": "node run-electron.js",
    "dist": "electron-builder --win nsis portable",
    "dist:local": "node build-local.js",
    "dist:check": "node build-local.js --check",
    "test": "node --test \"tests/*.test.js\""
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.bunimseller.supersuite",
    "productName": "SuperSuite",
    "files": [
      "main.js",
      "shell/**/*",
      "modules/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "SuperSuite-Portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SuperSuite-Setup.${ext}"
    },
    "icon": "build/icon.ico"
  }
}
