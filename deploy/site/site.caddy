# אתר השיווק (deploy/site/public) — בלוק אתר נוסף לצד שרת הרישוי, באותו Caddy.
# נטען מ-deploy/relay/Caddyfile דרך: import /etc/caddy/sites/*.caddy
# הדומיין מגיע מ-SITE_DOMAIN (deploy/site/.env). בלי Docker: להחליף את {$SITE_DOMAIN} בדומיין,
# ואת /srv/site בנתיב התיקייה public בשרת.
{$SITE_DOMAIN} {
	root * /srv/site
	encode zstd gzip

	# קבצים שאינם חלק מהאתר (‎.gitkeep וכו') — לא מוגשים
	@hidden path */.*
	respond @hidden 404

	header {
		# הכול מאותו מקור: אין CDN, אין גופנים חיצוניים, אין סקריפטים ואין מעקב
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# עיצוב ותמונות — מטמון לשבוע. דף הבית וההורדות — תמיד בודקים מול השרת, כדי שגרסה חדשה תופיע מיד
	@assets path /img/* /styles.css /favicon.svg /icon.png
	header @assets Cache-Control "public, max-age=604800"
	@fresh path / /index.html /downloads/*
	header @fresh Cache-Control "no-cache"

	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
