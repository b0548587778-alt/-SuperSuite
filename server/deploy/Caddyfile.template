# Caddy obtains and renews the HTTPS certificate (Let's Encrypt) automatically.
# __DOMAIN__ is replaced by install.sh with your domain.
__DOMAIN__ {
	encode gzip
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:8443
	log {
		output file /var/log/caddy/supersuite-relay.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
